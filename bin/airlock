#!/usr/bin/env bash
# airlock — isolated, virtualized coding-agent workspaces.
#
# No /bin/bash in the guest this is developed against; keep the env shebang.
set -euo pipefail

# shellcheck disable=SC2034  # consumed by lib/common.sh's die/warn
airlock_prog="airlock"
# A sentinel until there are releases; `airlock version` adds the commit, which
# is what actually identifies a build. Keep in step with flake.nix.
AIRLOCK_VERSION="0.1.0-dev"

# airlock prints a report, not a document: git's pager would take the alternate
# screen in the middle of one and swallow everything printed after it. Pipe
# airlock to a pager yourself if you want one.
export GIT_PAGER=cat

# Installed builds substitute these; a source checkout finds them alongside.
AIRLOCK_LIB="${AIRLOCK_LIB:-$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)}"

# Which claude-microvm to launch, as a flake reference. An installed build has
# one baked in from this flake's lock; a source checkout leaves it unset and
# `run` reads the same revision out of flake.lock.
export AIRLOCK_SUBSTRATE="${AIRLOCK_SUBSTRATE:-}"

# The commit an installed build came from, baked in alongside the substrate. A
# source checkout leaves it unset and `version` asks git.
AIRLOCK_COMMIT="${AIRLOCK_COMMIT:-}"

# The nixpkgs this build is locked against, as a flake reference. Baked in like
# the substrate; a source checkout reads the same revision out of flake.lock.
# The default substrate is launched with its nixpkgs input overridden to this,
# and `airlock registry` builds from it, so one nixpkgs serves the whole stack.
AIRLOCK_NIXPKGS="${AIRLOCK_NIXPKGS:-}"

# Which container registry `airlock registry` runs, as a flake reference. Unset,
# it is `distribution` from the nixpkgs above; tests point it elsewhere.
AIRLOCK_REGISTRY_PKG="${AIRLOCK_REGISTRY_PKG:-}"

# shellcheck source=lib/common.sh
. "$AIRLOCK_LIB/common.sh"
# shellcheck source=lib/lfs.sh
. "$AIRLOCK_LIB/lfs.sh"
# shellcheck source=lib/init.sh
. "$AIRLOCK_LIB/init.sh"
# shellcheck source=lib/doctor.sh
. "$AIRLOCK_LIB/doctor.sh"
# shellcheck source=lib/fetch.sh
. "$AIRLOCK_LIB/fetch.sh"
# shellcheck source=lib/status.sh
. "$AIRLOCK_LIB/status.sh"
# shellcheck source=lib/run.sh
. "$AIRLOCK_LIB/run.sh"
# shellcheck source=lib/rm.sh
. "$AIRLOCK_LIB/rm.sh"
# shellcheck source=lib/stop.sh
. "$AIRLOCK_LIB/stop.sh"
# shellcheck source=lib/path.sh
. "$AIRLOCK_LIB/path.sh"
# shellcheck source=lib/config.sh
. "$AIRLOCK_LIB/config.sh"
# shellcheck source=lib/version.sh
. "$AIRLOCK_LIB/version.sh"
# shellcheck source=lib/registry.sh
. "$AIRLOCK_LIB/registry.sh"
# shellcheck source=lib/task.sh
. "$AIRLOCK_LIB/task.sh"
# shellcheck source=lib/hub.sh
. "$AIRLOCK_LIB/hub.sh"
# shellcheck source=lib/sandbox.sh
. "$AIRLOCK_LIB/sandbox.sh"
# shellcheck source=lib/git.sh
. "$AIRLOCK_LIB/git.sh"

usage() {
  cat <<'EOF'
usage: airlock <command> [args]

  init <name> --from-remote <url> | --from-local <path>
                          create a workspace
  task new|ls|rm <name> [<task>]
                          a workspace's tasks: lines of work, an agent and a VM each
  run <name> <task> [--dry-run] [--fresh]
                          launch a task's VM
  stop <name> <task> [--force]
                          power a task's VM off from outside it
  status [<name>]         what exists, what is running, what is waiting for you
  fetch <name>            refresh the hub from its configured upstreams
  doctor [<name>] [--fix] verify invariants; repair what is safely repairable
  rm <name> [--yes]       tear a workspace down, with confirmation
  config [--workspace <name>] [<key> [<value>]] | --list | --edit
  path <name> [--hub]     print where the workspace keeps something
  git <name> <task> [--] <git args...>
                          git in a task's worktree, confined as airlock's own is
  hub [start|stop|status] the SSH service guests fetch from and push to
  registry [start|stop] [<upstream>...]
                          pull-through registry caches for guests
  version                 print the version and the commit it was built from
EOF
}

main() {
  [ $# -gt 0 ] || { usage >&2; exit 2; }
  local cmd="$1"; shift
  # Commands that run git on work_dir decide here, in this shell, whether it can
  # be confined (D34): a refusal inside a `$(...)` or a redirected call would
  # end only that subshell, or say nothing.
  case "$cmd" in init|run|status|doctor|rm|task|git) sandbox_ready ;; esac
  case "$cmd" in
    init)            cmd_init "$@" ;;
    run)             cmd_run "$@" ;;
    status)          cmd_status "$@" ;;
    fetch)           cmd_fetch "$@" ;;
    doctor)          cmd_doctor "$@" ;;
    config)          cmd_config "$@" ;;
    path)            cmd_path "$@" ;;
    git)             cmd_git "$@" ;;
    stop)            cmd_stop "$@" ;;
    rm)              cmd_rm "$@" ;;
    registry)        cmd_registry "$@" ;;
    task)            cmd_task "$@" ;;
    hub)             cmd_hub "$@" ;;
    version|--version) cmd_version "$@" ;;
    help|-h|--help)  usage ;;
    *)               printf 'airlock: unknown command: %s\n\n' "$cmd" >&2; usage >&2; exit 2 ;;
  esac
}

main "$@"
